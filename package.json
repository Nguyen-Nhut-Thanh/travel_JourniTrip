{
  "name": "travel-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "dev:ai": "npm run dev --workspace=ai",
    "ai:index": "npm run index --workspace=ai",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run prisma:generate --workspace=database",
    "db:push": "npm run prisma:push --workspace=database",
    "db:sync:membership": "tsx --tsconfig apps/api/tsconfig.json scripts/sync-membership-wallet.ts",
    "db:import:provinces": "tsx scripts_data/cli/import-provinces.ts",
    "db:import:seasonal": "tsx scripts_data/cli/import-seasonal-showcase.ts",
    "seed:costumes": "tsx scripts_data/cli/seed-tour-costumes.ts",
    "seed:partners": "tsx scripts_data/cli/seed-partners.ts",
    "seed:hotels": "tsx scripts_data/cli/seed-hotels.ts",
    "seed:transports": "tsx scripts_data/cli/seed-transports.ts",
    "seed:attractions": "tsx scripts_data/cli/seed-attractions.ts",
    "db:backfill:booking-metadata": "tsx scripts/backfill-booking-metadata.ts",
    "grant-admin": "tsx scripts_data/cli/grant-admin.ts",
    "seed:diamond": "tsx scripts_data/cli/seed-diamond-member.ts",
    "seed:member": "tsx scripts_data/cli/seed-member-tier.ts",
    "data:studio": "tsx scripts_data/server.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.2"
  },
  "packageManager": "npm@11.5.2"
}
